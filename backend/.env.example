# Required for JWT (auth)
JWT_SECRET=your-secret-key-change-in-production

# Optional: allow frontend origin in production (e.g. https://your-app.netlify.app)
FRONTEND_URL=

# Optional: on Vercel use /tmp/library.db (data is ephemeral); omit for local SQLite file
# DATABASE_PATH=/tmp/library.db

# PORT is set by Vercel; use 5000 for local
# PORT=5000
