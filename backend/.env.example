# CRITICAL: Vercel Postgres - Data persistence
# Set this in Vercel Project Settings > Environment Variables
# Get the value from: Vercel Dashboard > Storage > Postgres > .env.local
POSTGRES_URL=

# Required for JWT (auth)
JWT_SECRET=your-secret-key-change-in-production

# Optional: allow frontend origin in production (e.g. https://your-app.netlify.app)
FRONTEND_URL=

# PORT is set by Vercel; use 5000 for local development
# PORT=5000
