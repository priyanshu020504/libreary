# CRITICAL: MongoDB Atlas - Persistent Data Storage
# Set this in Vercel Project Settings > Environment Variables
# Get the value from: MongoDB Atlas > Database > Connect > Connect your application
# Format: mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority
MONGODB_URI=

# Required for JWT (auth)
JWT_SECRET=your-secret-key-change-in-production

# Optional: allow frontend origin in production (e.g. https://your-app.netlify.app)
FRONTEND_URL=

# PORT is set by Vercel; use 5000 for local development
# PORT=5000
